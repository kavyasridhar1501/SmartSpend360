# =============================================================================
# SmartSpend360 — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# =============================================================================

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# --- S3 Configuration ---
S3_BUCKET_NAME=smartspend360-datalake
S3_RESULTS_BUCKET=smartspend360-athena-results

# --- DynamoDB Table Names ---
DYNAMODB_ALERTS_TABLE=ss360-alerts
DYNAMODB_METRICS_TABLE=ss360-metrics
DYNAMODB_FORECASTS_TABLE=ss360-forecasts
DYNAMODB_PIPELINE_TABLE=ss360-pipeline-runs

# --- Plaid API (use sandbox for free) ---
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
# Sandbox access token generated via /sandbox/public_token/create
PLAID_ACCESS_TOKEN=access-sandbox-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Alpha Vantage (free tier: 25 API calls/day) ---
ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key
# Get free key at: https://www.alphavantage.co/support/#api-key

# --- Open Exchange Rates (free tier: 1000 calls/month) ---
OPEN_EXCHANGE_APP_ID=your_open_exchange_app_id
# Get free app ID at: https://openexchangerates.org/signup/free

# --- Databricks Community Edition ---
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token
DATABRICKS_CLUSTER_ID=your_cluster_id
# Notebook paths (adjust after importing notebooks to Databricks)
DATABRICKS_NOTEBOOK_BASE=/Users/your-email@example.com/smartspend360

# --- Apache Airflow ---
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=your_airflow_password

# --- FastAPI Backend ---
API_KEY=your_secure_api_key_here
API_KEY_NAME=X-API-Key
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Athena ---
ATHENA_WORKGROUP=smartspend360
ATHENA_DATABASE=smartspend360_db
ATHENA_OUTPUT_LOCATION=s3://smartspend360-athena-results/query-results/

# --- CORS (Frontend URL) ---
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Railway (backend deployment) ---
# These are set automatically by Railway, shown here for reference
PORT=8000
RAILWAY_ENVIRONMENT=production
